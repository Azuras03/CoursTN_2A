    {
      "id": "NwSYn72J67u61OZcTc7fm",
      "type": "text",
      "x": 1186.0127371416706,
      "y": 2126.412707704661,
      "width": 881.1792602539062,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
