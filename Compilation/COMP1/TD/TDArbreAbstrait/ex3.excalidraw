      "text": "public class Person {\n    private string lastname\n    private int age\n    private string firstname\n    private string firstname\n\n    public Person (String f, String l){\n        firstName = 2;\n        lastName = l;\n        age = a;\n    }\n    public String getFirstName(){\n        return firstName;\n    }\n}",
